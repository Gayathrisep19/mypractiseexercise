   "source": [
    "def display(*colors,**profile):\n",
    "    for color in colors:\n",
    "        print(color,end=\" \")\n",
    "    for key,val in profile.items():\n",
    "        print({key:val},end=\" \")\n",
    "        \n",
    "display('red','blue','green',Name='Gayathri',Age=33,Country='India')"
   ]
